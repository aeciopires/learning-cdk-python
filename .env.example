# Copy to .env and source it (`set -a; source .env; set +a`), or export these
# variables another way, before running `uv run cdk ...`. See REQUIREMENTS.md
# and shared/config.py for how each one is used.

# --- Tag values (shared/tagging.py / shared/config.py) ---------------------
# Every value below maps to one of the mandatory tags. See REQUIREMENTS.md,
# "Tagging policy", for the full definition of each tag.
CDK_PRODUCT=learning-cdk-python
CDK_ENVIRONMENT=dev            # dev, stg, or prd (short names only - see shared/config.py)
CDK_TEAM_OWNER=platform-engineering
CDK_PCI=false
CDK_CELL_BASED=false
# CDK_CELL_ID=cell-01          # only read when CDK_CELL_BASED=true

# --- Module-specific options ------------------------------------------------
# modules/22_elasticache: the cache engine - valkey (default) or redis.
# CDK_ELASTICACHE_ENGINE=valkey

# --- AWS account/region (shared/config.py) ----------------------------------
# Left unset, stacks are "environment-agnostic" (deployable to any account or
# region) - see https://docs.aws.amazon.com/cdk/v2/guide/environments.html.
# The CDK CLI sets CDK_DEFAULT_ACCOUNT/CDK_DEFAULT_REGION for you from your
# current AWS CLI credentials/profile when you run cdk synth/deploy; set
# AWS_ACCOUNT_ID/AWS_REGION explicitly only if you need an override.
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=us-east-1

# --- floci (local AWS emulator, see docker-compose.yml) --------------------
# `eval $(floci env)` (floci CLI) sets these for you - listed here for
# reference, or for use without the CLI (docker compose only).
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
